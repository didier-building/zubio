# Zubio Brand Configuration
# Copy to .env and fill in real values
# DO NOT commit with real secrets!

# Product Branding
INSTALLATION_NAME=Zubio
BRAND_NAME=Zubio

# URLs (from brand.json)
FRONTEND_URL=https://app.zubio.rw
BACKEND_URL=https://api.zubio.rw

# Email Configuration
MAILER_SENDER_EMAIL=notifications@zubio.rw
SUPPORT_EMAIL=support@zubio.rw
MAILER_SENDER_NAME=Zubio Support

# Policy Links
TERMS_URL=https://zubio.rw/terms
PRIVACY_POLICY_URL=https://zubio.rw/privacy

# Feature Flags
ENABLE_ACCOUNT_SIGNUP=false

# Required Secrets (REPLACE THESE!)
SECRET_KEY_BASE=REPLACE_WITH_SECURE_RANDOM_KEY
REDIS_URL=redis://redis:6379
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional: Sentry, Analytics
SENTRY_DSN=
# DATA_RETENTION_DAYS=90

# Docker/Production specific
RAILS_ENV=development
NODE_ENV=development
RAILS_LOG_TO_STDOUT=true
